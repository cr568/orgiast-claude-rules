+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { diffRoutingCategories, formatRoutingEntry, writeRoutingHandoff } from './eval-harness.mjs';
+
+const table = (categories) => `${JSON.stringify({ builtAt: '2026-09-29T00:00:00.000Z', categories }, null, 2)}\n`;
+const entry = (provider, model, extra = {}) => ({ provider, model, rate: 1, usdPerTask: 0.0001, msAvg: 900, samples: 3, ...extra });
+
+test('無変更なら差分ゼロ・ファイルを作らない', () => {
+  const text = table({ code: entry('deepseek', 'deepseek-chat') });
+  assert.deepEqual(diffRoutingCategories(text, text), []);
+  const runsDir = fs.mkdtempSync(path.join(os.tmpdir(), 'rt-handoff-'));
+  assert.equal(writeRoutingHandoff({ beforeText: text, afterText: text, runsDir, stamp: '2026-09-29' }), null);
+  assert.deepEqual(fs.readdirSync(runsDir), []);
+});
+
+test('モデル/速度の変更をカテゴリ単位で検出する', () => {
+  const before = table({ code: entry('openrouter', 'llama-3.3-70b', { msAvg: 2078 }), jp_reply: entry('deepseek', 'deepseek-chat') });
+  const after = table({ code: entry('deepseek', 'deepseek-chat', { msAvg: 933 }), jp_reply: entry('deepseek', 'deepseek-chat') });
+  const rows = diffRoutingCategories(before, after);
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].category, 'code');
+  assert.match(rows[0].before, /openrouter\/llama-3\.3-70b/);
+  assert.match(rows[0].after, /deepseek\/deepseek-chat/);
+});
+
+test('カテゴリの追加・削除も検出する', () => {
+  const before = table({ code: entry('deepseek', 'deepseek-chat') });
+  const after = table({ summarize: entry('groq', 'openai-gpt-oss-120b') });
+  const rows = diffRoutingCategories(before, after);
+  assert.deepEqual(rows.map((r) => r.category), ['code', 'summarize']);
+  assert.equal(rows[0].after, '(なし)');
+  assert.equal(rows[1].before, '(なし)');
+});
+
+test('壊れた JSON でも例外を投げない', () => {
+  assert.deepEqual(diffRoutingCategories('', 'not json'), []);
+  assert.equal(formatRoutingEntry(null), '(なし)');
+});
+
+test('変更時は runs/ に成果物と引き継ぎメモを書く(read-back 検証)', () => {
+  const before = table({ code: entry('openrouter', 'llama-3.3-70b', { msAvg: 2078 }) });
+  const after = table({ code: entry('deepseek', 'deepseek-chat', { msAvg: 933 }) });
+  const runsDir = fs.mkdtempSync(path.join(os.tmpdir(), 'rt-handoff-'));
+  const r = writeRoutingHandoff({ beforeText: before, afterText: after, runsDir, stamp: '2026-09-29' });
+  assert.ok(r);
+  assert.equal(r.rows.length, 1);
+  // 成果物は「そのままコピーできる」= 書き戻した文字列が after と完全一致
+  assert.equal(fs.readFileSync(r.jsonPath, 'utf8'), after);
+  assert.equal(JSON.parse(fs.readFileSync(r.jsonPath, 'utf8')).categories.code.model, 'deepseek-chat');
+  const note = fs.readFileSync(r.notePath, 'utf8');
+  assert.match(note, /code: openrouter\/llama-3\.3-70b .*→.*deepseek\/deepseek-chat/);
+  assert.match(note, /tools\/routing-table\.json/);
+  assert.match(note, /automerge/);
+  assert.equal(fs.readdirSync(runsDir).length, 2);
+});
