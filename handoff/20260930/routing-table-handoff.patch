+      for (const r of handoff.rows) console.log(`  ${r.category}: ${r.before} → ${r.after}`);
+    }
+  } catch (error) { console.error(`routing-table 引き継ぎ作成失敗: ${String(error?.message ?? error)}`); }
 }
 }
 if (isEntry(import.meta.url)) await main();
+
+// ── routing-table 引き継ぎ(生成物を失わない経路の確保) ────────────────────────
+// eval-harness --all は計測後に tools/routing-table.json を書き換えるだけで
+// commit/push しないため、push 権限の無いPCで回すと更新が rescue ブランチに
+// 吸われて誰もマージしないまま消える(2026-09-29 実測・runs/2026-09-29-3.summary.md)。
+// 変更を検出したら runs/ に「そのままコピーできる成果物 + 引き継ぎメモ」を残す。
+export function formatRoutingEntry(entry) {
+  if (!entry) return '(なし)';
+  const rate = typeof entry.rate === 'number' ? `${(entry.rate * 100).toFixed(0)}%` : '?%';
+  return `${entry.provider}/${entry.model} ${rate} $${entry.usdPerTask} ${entry.msAvg}ms n=${entry.samples}`;
+}
+function safeParseTable(text) { if (typeof text !== 'string' || !text.trim()) return null; try { return JSON.parse(text); } catch { return null; } }
+/** 変更のあったカテゴリだけを {category, before, after} で返す(無変更なら空配列)。 */
+export function diffRoutingCategories(beforeText, afterText) {
+  const a = safeParseTable(beforeText)?.categories ?? {}, b = safeParseTable(afterText)?.categories ?? {};
+  const rows = [];
+  for (const category of [...new Set([...Object.keys(a), ...Object.keys(b)])].sort()) {
+    const before = formatRoutingEntry(a[category]), after = formatRoutingEntry(b[category]);
+    if (before !== after) rows.push({ category, before, after });
+  }
+  return rows;
+}
+/** 変更があるときだけ runs/ に成果物とメモを書く。無変更なら null(毎晩ゴミを増やさない)。 */
+export function writeRoutingHandoff({ beforeText, afterText, runsDir, stamp, relPath = 'tools/routing-table.json' }) {
+  const rows = diffRoutingCategories(beforeText, afterText);
+  if (!rows.length) return null;
+  fs.mkdirSync(runsDir, { recursive: true });
+  const jsonPath = path.join(runsDir, `${stamp}-routing-table.json`), notePath = path.join(runsDir, `${stamp}-routing-table-handoff.md`);
+  fs.writeFileSync(jsonPath, afterText, 'utf8');
+  fs.writeFileSync(notePath, `${[
+    `# routing-table 引き継ぎ (${stamp})`, '',
+    `計測により ${relPath} が更新されたが、このPCは上流への push 権限を持たない`,
+    '(`cr568` = pull のみ / fork PR は auto-merge.yml 条件1で対象外)。更新を失わないため、下記を残す。', '',
+    '## 変更(カテゴリ: 変更前 → 変更後)',
+    ...rows.map((r) => `- ${r.category}: ${r.before} → ${r.after}`), '',
+    '## write 権限のあるPCでの適用(人手ゼロ)',
+    '1. 正本ブランチを origin/main から切る',
+    `2. このフォルダの \`${path.basename(jsonPath)}\` を \`${relPath}\` にコピー`,
+    '3. `node --test tools/routing-table.test.mjs` / `node --test tools/eval-harness.test.mjs` を通す',
+    '4. commit → push → `automerge` ラベル付与(fork 経由は不可)', '',
+    `成果物: ${jsonPath}`,
+  ].join('\n')}\n`, 'utf8');
+  return { jsonPath, notePath, rows };
+}
